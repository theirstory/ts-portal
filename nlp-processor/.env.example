# Weaviate Configuration
WEAVIATE_HOST_URL=weaviate
WEAVIATE_PORT=8080
WEAVIATE_SECURE=false

# Chunking Configuration
# Number of sentences per chunk.
# Smaller values create more precise chunks; larger values preserve more context.
SENTENCE_CHUNK_SIZE=10

# Number of sentences repeated between consecutive chunks.
# Use 0 for no overlap; 3-5 is a good default for retrieval.
SENTENCE_OVERLAP=5

# Guardrails to avoid storing tiny or noisy chunks.
MIN_WORDS_PER_CHUNK=10
MIN_CHARS_PER_CHUNK=50
MAX_WORDS_PER_CHUNK=200

# NER Configuration
CONFIG_PATH=../config.json
NER_LABELS=person,organization,location,date,event,technology

# GLiNER Model Configuration
GLINER_MODEL=urchade/gliner_multi-v2.1
GLINER_THRESHOLD=0.3
GLINER_LOAD_TIMEOUT_SECONDS=240
MIN_TEXT_LENGTH_FOR_NER=50

# HuggingFace Local Embeddings Configuration
# Default embedding model for this project. Qwen3-VL-Embedding is multimodal: text and
# images share one vector space, which is what makes unified search across recordings,
# documents, and images possible. 2048 dimensions.
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B

# Alternatives (text-only — document and image ingest is unavailable with these):
# EMBEDDING_MODEL=sentence-transformers/LaBSE
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#
# Changing the model changes the vector width, so it requires recreating the Weaviate
# collections (WEAVIATE_RESET_SCHEMA=true) and re-importing. It is not an env-var flip.
EMBEDDING_LOAD_TIMEOUT_SECONDS=600

# Matryoshka truncation: shorter vectors, smaller index, graceful quality loss.
# 0 keeps the model's native width. Also requires recreating collections when changed.
EMBEDDING_TRUNCATE_DIM=0

# Page images cost roughly an order of magnitude more to embed than text, so they get
# their own batch size, and their long edge is capped to bound peak memory.
EMBEDDING_IMAGE_BATCH_SIZE=2
EMBEDDING_IMAGE_MAX_EDGE=1600

# GPU Configuration (requires CUDA to be installed)
USE_GPU=false

# Overrides device selection entirely: cuda, mps, or cpu. Empty means auto-detect
# (cuda if USE_GPU, else Apple Silicon MPS if present, else cpu). Set this to mps when
# running the service natively on a Mac — Docker cannot reach MPS, and embedding page
# images on CPU is painfully slow.
EMBEDDING_DEVICE=
